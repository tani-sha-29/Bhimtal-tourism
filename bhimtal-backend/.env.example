# Bhimtal Portal Backend - Environment Variables Configuration

# Server
PORT=8080

# Supabase PostgreSQL Database Settings
# Option A: Full Connection String (Transaction Pooler or Direct)
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres.your-project-ref
# SPRING_DATASOURCE_PASSWORD=your-database-password

# Option B: Individual Components
SUPABASE_DB_HOST=db.zaqrafnolcyufxbofkrq.supabase.co
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASSWORD=your-database-password

# Hibernate DDL Auto (update, validate, none)
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# SMTP Mail Settings (e.g. Gmail App Password, Resend, SendGrid)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-gmail-app-password

# Notifications & CORS
NOTIFICATION_EMAIL=admin@bhimtaltravel.com
MAIL_FROM=noreply@bhimtaltravel.com
CORS_ALLOWED_ORIGINS=http://localhost:3000
